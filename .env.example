# ==============================================================================
# HealthSlip AI - Environment Configuration & Production Deployment Guide
# ==============================================================================

PROJECT_NAME="HealthSlip AI"
# Options: development, staging, production
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 1. MySQL 8.0 Primary Relational Database (Strictly Required in Production)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=healthslip_user
MYSQL_PASSWORD=your_strong_mysql_password_here
MYSQL_DB=healthslip_prod
DATABASE_URL=mysql+pymysql://healthslip_user:your_strong_mysql_password_here@localhost:3306/healthslip_prod

# In development, set FALLBACK_TO_SQLITE=True. In production, this MUST be False.
FALLBACK_TO_SQLITE=True
SQLITE_DB_PATH=sqlite:///./healthslip.db

# ------------------------------------------------------------------------------
# 2. Cryptographic Security, HMAC Key Rotation & Data Encryption (DPDP Act 2023)
# ------------------------------------------------------------------------------
# SECRET_KEY must be a random, high-entropy 32+ character string in production.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=healthslip_ai_production_hmac_secret_key_v1_secure_change_me
HMAC_KEY_VERSION=v1

# Fernet 32-byte URL-safe base64 key for patient demographic encryption at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# CORS Allowed Origins (Comma-separated list, e.g., https://healthslip.ai,https://pos.healthslip.ai)
CORS_ALLOWED_ORIGINS="*"

# ------------------------------------------------------------------------------
# 3. OTP Authentication & Pluggable Indian SMS Providers (TRAI / DLT Compliant)
# ------------------------------------------------------------------------------
# Provider options: 'console' (local mock), 'fast2sms', 'msg91'
SMS_PROVIDER=console

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
RATE_LIMIT_IP_MAX_PER_HOUR=15
RATE_LIMIT_PHONE_MAX_PER_HOUR=5

# Set DEV_OTP_SANDBOX_MODE=False in production so sandbox OTPs are never returned in APIs or UI
DEV_OTP_SANDBOX_MODE=True

# Fast2SMS Configuration (Quick Indian SMS Gateway)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TE_ID=

# MSG91 Enterprise DLT Gateway Configuration
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HLTSLP
MSG91_DLT_TE_ID=

# ------------------------------------------------------------------------------
# 4. Redis Pub/Sub & Scalable Real-Time WebSocket Scaling
# ------------------------------------------------------------------------------
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Clinical AI Assistant & Heuristic Offline Engine
# ------------------------------------------------------------------------------
# If ENABLE_EXTERNAL_AI=False, the system uses the built-in clinical NLP heuristic engine.
# If True, clinical notes are de-identified before being sent to Google Gemini Flash.
ENABLE_EXTERNAL_AI=False
GEMINI_API_KEY=
