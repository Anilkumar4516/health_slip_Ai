# HealthSlip AI Environment Configuration
PROJECT_NAME="HealthSlip AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL Primary)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=healthslip_prod

# Primary SQLAlchemy URL
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/healthslip_prod

# Fallback to SQLite if MySQL is not reachable
FALLBACK_TO_SQLITE=True
SQLITE_DB_PATH=sqlite:///./healthslip.db

# Security & OTP
SECRET_KEY=healthslip_ai_cryptographic_hmac_secret_2026_secured
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
DEV_OTP_SANDBOX_MODE=True

# AI Assistant (Optional Google Gemini API Key for clinical analysis)
GEMINI_API_KEY=your_gemini_api_key_here
