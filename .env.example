# Environment
PROJECT_NAME="HealthSlip AI"
ENVIRONMENT="production"               # 'development' or 'production'
DEBUG=False
LOG_LEVEL="INFO"

# Primary MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=healthslip_user
MYSQL_PASSWORD=<your_mysql_password>
MYSQL_DB=healthslip_prod
DATABASE_URL=mysql+pymysql://healthslip_user:<your_mysql_password>@localhost:3306/healthslip_prod
FALLBACK_TO_SQLITE=False               # Strictly False in production

# Security & Encryption
SECRET_KEY=<generate_random_64_character_hex_string>
HMAC_KEY_VERSION=v1
DATA_ENCRYPTION_KEY=<generate_32_byte_fernet_key>
CORS_ALLOWED_ORIGINS="https://yourstore.com,https://pos.yourstore.com"

# SMS Gateway (Fast2SMS / MSG91 / Console Mock)
SMS_PROVIDER=msg91                     # 'console', 'fast2sms', or 'msg91'
DEV_OTP_SANDBOX_MODE=False             # Suppresses sandbox OTPs
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
RATE_LIMIT_IP_MAX_PER_HOUR=15
RATE_LIMIT_PHONE_MAX_PER_HOUR=5

# MSG91 DLT Configuration
MSG91_AUTH_KEY=<your_msg91_auth_key>
MSG91_SENDER_ID=HLTSLP
MSG91_DLT_TE_ID=<your_trai_dlt_template_id>

# Fast2SMS Configuration
FAST2SMS_API_KEY=<your_fast2sms_api_key>
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TE_ID=

# Real-Time Redis Scaling
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Clinical AI
ENABLE_EXTERNAL_AI=False               # Set True if using Google Gemini Flash
GEMINI_API_KEY=